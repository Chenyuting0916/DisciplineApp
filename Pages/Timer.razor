@page "/timer"
@using DisciplineApp.Services
@using DisciplineApp.Services.Interfaces
@inject IGamificationService GamificationService
@inject AuthenticationStateProvider _authStateProvider
@inject ToastService ToastService
@inject ITaskService TaskService
@inject IJSRuntime JSRuntime
@inject TimerService TimerService
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> Localizer
@inject IAnalyticsService AnalyticsService
@inject LocalStorageService LocalStorageService
@inject IIfThenService IfThenService
@inject GuestIfThenService GuestIfThenService
@implements IDisposable

<PageTitle>@Localizer["Timer"] — Discipline</PageTitle>

<div class="timer-shell text-center" @onkeydown="HandleKey" tabindex="0">
    <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
        @if (!sanctuary)
        {
            <button class="btn btn-outline-primary" @onclick="EnterSanctuary">🕯 @Localizer["EnterSanctuary"]</button>
        }
        else
        {
            <button class="btn btn-outline-primary" @onclick="ExitSanctuary">@Localizer["LeaveSanctuary"]</button>
        }
    </div>
    <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
        @foreach (var sound in sounds)
        {
            <button class="preset-chip @(ambient == sound.Id ? "active" : "")" @onclick="() => SetAmbient(sound.Id)">@sound.Label</button>
        }
    </div>
    <p class="small text-muted mb-3">@Localizer["SanctuaryHint"]</p>
    <div class="volume-row">
        <span aria-hidden="true">🔊</span>
        <input type="range" min="0" max="100" value="@volumePercent" @oninput="OnVolumeInput" />
        <span class="small text-muted">@volumePercent%</span>
    </div>

    <div class="btn-group mb-4" role="group">
        <button class="btn @(TimerService.IsPomodoroMode && !TimerService.IsBreakMode ? "btn-primary" : "btn-outline-primary")"
                @onclick="@(() => TimerService.SetMode(true))" disabled="@TimerService.IsRunning">
            @Localizer["Focus"]
        </button>
        <button class="btn @(!TimerService.IsPomodoroMode ? "btn-primary" : "btn-outline-primary")"
                @onclick="@(() => TimerService.SetMode(false))" disabled="@TimerService.IsRunning">
            @Localizer["Stopwatch"]
        </button>
        <button class="btn @(TimerService.IsBreakMode ? "btn-primary" : "btn-outline-primary")"
                @onclick="StartSuggestedBreak" disabled="@TimerService.IsRunning">
            @Localizer["Break"]
        </button>
    </div>

    @if (TimerService.IsPomodoroMode && !TimerService.IsBreakMode)
    {
        <div class="d-flex justify-content-center gap-2 mb-4">
            @foreach (var preset in new[] { 15, 25, 50 })
            {
                <button class="preset-chip @(TimerService.PomodoroMinutes == preset ? "active" : "")"
                        @onclick="@(() => TimerService.SetPomodoroMinutes(preset))"
                        disabled="@TimerService.IsRunning">@preset @Localizer["MinutesShort"]</button>
            }
        </div>
    }

    <div class="mb-4" style="max-width: 400px; margin: 0 auto;">
        @if (todayTasks != null && todayTasks.Any())
        {
            <select class="form-select bg-dark text-white border-secondary mb-2" @bind="TimerService.FocusTask" disabled="@TimerService.IsRunning">
                <option value="">@Localizer["SelectTask"]</option>
                @foreach (var task in todayTasks.Where(t => !t.IsCompleted || t.IsRoutine))
                {
                    <option value="@task.Title">@task.Title</option>
                }
                <option value="custom">@Localizer["CustomTask"]</option>
            </select>
        }
        
        @if (TimerService.FocusTask == "custom" || todayTasks == null || !todayTasks.Any())
        {
            <input type="text" class="form-control text-center" 
                   placeholder="@Localizer["FocusPlaceholder"]" 
                   maxlength="80"
                   @bind="customFocusTask" 
                   disabled="@TimerService.IsRunning" />
        }
    </div>

    <ProgressRing Percent="@RingPercent" Size="260" Color="@(TimerService.IsBreakMode ? "#2dd4bf" : "#f5a524")">
        <div class="small text-muted text-uppercase fw-bold" style="letter-spacing: .12em;">
            @(TimerService.IsBreakMode ? Localizer["Break"] : Localizer["Focus"])
        </div>
        <div style="font-size: 3.2rem; font-weight: 800; font-family: Outfit, monospace; line-height: 1;">@TimeDisplay</div>
        <div class="small text-muted mt-1">@string.Format(Localizer["SessionsToday"], TimerService.CompletedPomodoros)</div>
    </ProgressRing>

    <div class="controls d-flex flex-column align-items-center gap-3 mt-4">
        @if (!TimerService.IsRunning && !TimerService.IsPaused)
        {
            <button class="btn btn-lg btn-success px-5" @onclick="RequestStart">
                <i class="bi bi-play-fill"></i> @Localizer["Start"]
            </button>
        }
        else if (TimerService.IsRunning)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-lg btn-warning px-4" @onclick="PauseTimer">
                    <i class="bi bi-pause-fill"></i> @Localizer["Pause"]
                </button>
                <button class="btn btn-lg btn-danger px-4" @onclick="StopTimer">
                    <i class="bi bi-stop-fill"></i> @Localizer["Finish"]
                </button>
            </div>
        }
        else if (TimerService.IsPaused)
        {
             <div class="d-flex gap-2">
                <button class="btn btn-lg btn-success px-4" @onclick="RequestStart">
                    <i class="bi bi-play-fill"></i> @Localizer["Resume"]
                </button>
                <button class="btn btn-lg btn-danger px-4" @onclick="StopTimer">
                    <i class="bi bi-stop-fill"></i> @Localizer["Finish"]
                </button>
            </div>
        }
    </div>

    @if (offerBreak)
    {
        <div class="mt-4">
            <p class="text-muted mb-2">@Localizer["TakeABreak"]</p>
            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-outline-primary" @onclick="@(() => BeginBreak(false))">@Localizer["ShortBreak"] · 5m</button>
                <button class="btn btn-outline-primary" @onclick="@(() => BeginBreak(true))">@Localizer["LongBreak"] · 15m</button>
                <button class="btn btn-link text-muted" @onclick="() => offerBreak = false">@Localizer["ContinueFocusing"]</button>
            </div>
        </div>
    }
    
    @if (activePlans.Any())
    {
        <div class="mt-4 text-start">
            <p class="small text-muted mb-2">@Localizer["IfThenTitle"]</p>
            @foreach (var plan in activePlans.Take(3))
            {
                <div class="small mb-1">@Localizer["IfLabel"] @plan.IfCue → @plan.ThenAction</div>
            }
        </div>
    }

    <div class="mt-4">
        <button class="btn btn-link text-muted text-decoration-none" @onclick="ShowManualEntryModal">
            <small>@Localizer["ForgotToTrack"]</small>
        </button>
    </div>
</div>

@if (showBreath)
{
    <div class="breath-overlay">
        <div class="breath-circle @breathPhase"></div>
        <div class="h4 mb-1">@BreathLabel</div>
        <p class="text-muted mb-3">@Localizer["BreathHint"]</p>
        <div class="d-flex gap-2 flex-wrap justify-content-center">
            <button class="btn btn-outline-primary" @onclick="SkipBreath">@Localizer["SkipBreath"]</button>
            <button class="btn btn-link text-muted" @onclick="SkipBreathForever">@Localizer["SkipBreathAlways"]</button>
        </div>
    </div>
}

@if (showManualEntry)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@Localizer["AddManualEntry"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseManualEntryModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Task"]</label>
                         @if (todayTasks != null && todayTasks.Any())
                        {
                            <select class="form-select bg-dark text-white border-secondary mb-2" @bind="manualTaskSelection">
                                <option value="">@Localizer["SelectTask"]</option>
                                @foreach (var task in todayTasks.Where(t => !t.IsCompleted || t.IsRoutine))
                                {
                                    <option value="@task.Title">@task.Title</option>
                                }
                                <option value="custom">@Localizer["CustomTask"]</option>
                            </select>
                        }
                        
                        @if (manualTaskSelection == "custom" || todayTasks == null || !todayTasks.Any())
                        {
                            <input type="text" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="@Localizer["EnterTaskName"]" 
                                   @bind="manualCustomTask" />
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["DurationMinutes"]</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="manualDuration" min="1" max="1440" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["When"]</label>
                        <input type="datetime-local" class="form-control bg-dark text-white border-secondary" @bind="manualDate" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManualEntryModal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveManualEntry">@Localizer["Save"]</button>
                </div>
            </div>
        </div>
    </div>
}

<DisciplineApp.Shared.CoinReward IsVisible="@showCoinReward" Coins="@coinsEarned" Xp="@xpEarned" />

<audio id="timerSound" src="sounds/alarm.mp3" preload="auto"></audio>
<audio id="startSound" src="sounds/start.mp3" preload="auto"></audio>

@code {
    private string customFocusTask = "";
    private List<UserTask>? todayTasks;
    private bool offerBreak;
    private bool sanctuary;
    private string ambient = "off";
    private record SoundOpt(string Id, string Label);
    private List<SoundOpt> sounds = new();
    
    private bool showCoinReward = false;
    private int coinsEarned = 0;
    private int xpEarned = 0;
    
    private bool showManualEntry = false;
    private string manualTaskSelection = "";
    private string manualCustomTask = "";
    private int manualDuration = 30;
    private DateTime manualDate = DateTime.Now;
    private int volumePercent = 37;
    private bool skipBreath;
    private bool showBreath;
    private string breathPhase = "inhale";
    private CancellationTokenSource? breathCts;
    private List<IfThenPlan> activePlans = new();
    private string? timerUserId;

    private string BreathLabel => breathPhase switch
    {
        "inhale" => Localizer["BreathInhale"],
        "hold-in" => Localizer["BreathHold"],
        "exhale" => Localizer["BreathExhale"],
        _ => Localizer["BreathHold"]
    };

    private double VolumeGain => volumePercent / 100.0 * 0.6;

    private double RingPercent => TimerService.IsPomodoroMode
        ? TimerService.Progress
        : Math.Min(TimerService.TimeElapsed.TotalMinutes / 60.0, 1);

    protected override async Task OnInitializedAsync()
    {
        TimerService.OnTick += UpdateUI;
        TimerService.OnTimerCompleted += HandleTimerCompleted;
        
        if (!string.IsNullOrEmpty(TimerService.FocusTask))
        {
            customFocusTask = TimerService.FocusTask;
        }

        sounds = new()
        {
            new("off", Localizer["SoundOff"]),
            new("rain", Localizer["SoundRain"]),
            new("brown", Localizer["SoundBrown"]),
            new("cafe", Localizer["SoundCafe"]),
            new("fire", Localizer["SoundFire"]),
        };
        
        await LoadTasks();

        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        timerUserId = authState.User.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
        if (!string.IsNullOrEmpty(timerUserId))
        {
            activePlans = await IfThenService.GetActiveAsync(timerUserId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var storedVolume = await LocalStorageService.GetItemAsync<int?>("discipline_volume");
        if (storedVolume.HasValue)
        {
            volumePercent = Math.Clamp(storedVolume.Value, 0, 100);
        }
        skipBreath = await LocalStorageService.GetItemAsync<bool>("discipline_skip_breath");
        await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);

        if (string.IsNullOrEmpty(timerUserId))
        {
            activePlans = await GuestIfThenService.GetActiveAsync();
        }
        StateHasChanged();
    }
    
    private async Task LoadTasks()
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                todayTasks = await TaskService.GetTasksForDateAsync(userId, DateTime.Today);
            }
        }
    }

    private void UpdateUI()
    {
        InvokeAsync(StateHasChanged);
    }

    private string TimeDisplay => TimerService.IsPomodoroMode ? 
        $"{(int)TimerService.TimeLeft.TotalMinutes:D2}:{TimerService.TimeLeft.Seconds:D2}" : 
        $"{(int)TimerService.TimeElapsed.TotalMinutes:D2}:{TimerService.TimeElapsed.Seconds:D2}";

    private void StartSuggestedBreak()
    {
        var isLong = TimerService.CompletedPomodoros > 0 && TimerService.CompletedPomodoros % 4 == 0;
        TimerService.StartBreak(isLong);
    }

    private void BeginBreak(bool isLong)
    {
        offerBreak = false;
        TimerService.StartBreak(isLong);
        TimerService.Start();
    }

    private async Task RequestStart()
    {
        if (showBreath)
        {
            await SkipBreath();
            return;
        }

        if (TimerService.IsPaused || TimerService.IsBreakMode || skipBreath)
        {
            await BeginSession();
            return;
        }

        showBreath = true;
        breathPhase = "inhale";
        breathCts?.Cancel();
        breathCts = new CancellationTokenSource();
        var token = breathCts.Token;
        try
        {
            foreach (var phase in new[] { "inhale", "hold-in", "exhale", "hold-out" })
            {
                breathPhase = phase;
                StateHasChanged();
                await Task.Delay(4000, token);
            }
            showBreath = false;
            await BeginSession();
        }
        catch (TaskCanceledException)
        {
            showBreath = false;
        }
    }

    private async Task SkipBreath()
    {
        breathCts?.Cancel();
        showBreath = false;
        await BeginSession();
    }

    private async Task SkipBreathForever()
    {
        skipBreath = true;
        await LocalStorageService.SetItemAsync("discipline_skip_breath", true);
        await SkipBreath();
    }

    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var percent)) return;
        volumePercent = Math.Clamp(percent, 0, 100);
        await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
        await LocalStorageService.SetItemAsync("discipline_volume", volumePercent);
    }

    private async Task BeginSession()
    {
        string taskName;
        
        if (todayTasks == null || !todayTasks.Any() || TimerService.FocusTask == "custom")
        {
            taskName = customFocusTask;
        }
        else
        {
            taskName = TimerService.FocusTask;
        }

        if (string.IsNullOrWhiteSpace(taskName))
        {
            taskName = TimerService.IsBreakMode ? Localizer["Break"] : (Localizer["Focus Session"] ?? "Focus Session");
        }
        
        TimerService.FocusTask = InputGuard.Clamp(taskName, InputGuard.FocusTaskMax);
        TimerService.Start();
        await PlaySound("startSound");
        if (ambient != "off")
        {
            await JSRuntime.InvokeVoidAsync("sanctuary.start", ambient);
            await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
        }

        var trackData = System.Text.Json.JsonSerializer.Serialize(new { 
            Mode = TimerService.IsBreakMode ? "Break" : TimerService.IsPomodoroMode ? "Pomodoro" : "Stopwatch",
            Task = TimerService.FocusTask 
        });
        await AnalyticsService.TrackEventAsync("Timer_Start", "Timer", trackData);
    }

    private void PauseTimer()
    {
        TimerService.Stop();
    }

    private async Task StopTimer()
    {
        TimerService.Stop();
        
        double durationMinutes = TimerService.IsPomodoroMode ? 
            (TimerService.DefaultPomodoroTime - TimerService.TimeLeft).TotalMinutes : 
            TimerService.TimeElapsed.TotalMinutes;

        if (durationMinutes >= 0.1 && !TimerService.IsBreakMode) 
        {
            await RecordSession(durationMinutes);
        }
        
        var trackData = System.Text.Json.JsonSerializer.Serialize(new { 
            Duration = durationMinutes,
            Completed = false,
            Mode = TimerService.IsPomodoroMode ? "Pomodoro" : "Stopwatch"
        });
        await AnalyticsService.TrackEventAsync("Timer_Stop", "Timer", trackData);

        if (TimerService.IsBreakMode)
        {
            TimerService.EndBreak();
        }
        else
        {
            TimerService.ResetTimer();
        }
        offerBreak = false;
    }

    private async void HandleTimerCompleted()
    {
        await InvokeAsync(async () => 
        {
            await PlaySound("timerSound");

            if (TimerService.IsBreakMode)
            {
                ToastService.ShowSuccess(Localizer["BreakComplete"]);
                TimerService.EndBreak();
                return;
            }

            await RecordSession(TimerService.DefaultPomodoroTime.TotalMinutes);
            
            var trackData = System.Text.Json.JsonSerializer.Serialize(new { 
                Duration = TimerService.DefaultPomodoroTime.TotalMinutes,
                Completed = true,
                Mode = "Pomodoro"
            });
            await AnalyticsService.TrackEventAsync("Timer_Stop", "Timer", trackData);

            TimerService.ResetTimer();
            offerBreak = true;
            ToastService.ShowSuccess(Localizer["PomodoroCompleted"]);
        });
    }

    private async Task RecordSession(double minutes)
    {
        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                string taskName = TimerService.FocusTask == "custom" ? customFocusTask : TimerService.FocusTask;
                if (string.IsNullOrEmpty(taskName)) taskName = customFocusTask;
                
                var result = await GamificationService.RecordFocusSessionAsync(userId, minutes, taskName, TimerService.IsPomodoroMode);
                
                if (result.success)
                {
                    xpEarned = result.xpAwarded;
                    coinsEarned = result.coinsAwarded;
                    
                    string msg = string.Format(Localizer["SessionRecordedXP"], xpEarned);
                    
                    if (coinsEarned > 0)
                    {
                        showCoinReward = true;
                        StateHasChanged();
                        
                        var _ = Task.Delay(3000).ContinueWith(_ => 
                        {
                            showCoinReward = false;
                            InvokeAsync(StateHasChanged);
                        });
                        
                        msg += string.Format(Localizer["PlusCoins"], coinsEarned);
                    }
                    ToastService.ShowSuccess(msg);
                }
            }
        }
    }
    
    private async Task PlaySound(string elementId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("playAudio", elementId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error playing sound: {ex.Message}");
        }
    }

    private void ShowManualEntryModal()
    {
        manualDate = DateTime.Now;
        manualDuration = 30;
        manualTaskSelection = "";
        manualCustomTask = "";
        showManualEntry = true;
    }

    private void CloseManualEntryModal()
    {
        showManualEntry = false;
    }

    private async Task SaveManualEntry()
    {
        if (manualDuration <= 0)
        {
             ToastService.ShowError(Localizer["DurationPositive"]);
             return;
        }

        string taskName = manualTaskSelection == "custom" ? manualCustomTask : manualTaskSelection;
        if (string.IsNullOrWhiteSpace(taskName))
        {
            if (!string.IsNullOrWhiteSpace(manualCustomTask)) taskName = manualCustomTask;
            else taskName = Localizer["ManualSession"];
        }

        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
             var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
             if (!string.IsNullOrEmpty(userId))
             {
                 var result = await GamificationService.RecordFocusSessionAsync(userId, manualDuration, taskName, false, manualDate);
                 
                 if (result.success)
                 {
                     string msg = string.Format(Localizer["ManualEntrySaved"], result.xpAwarded);
                     ToastService.ShowSuccess(msg);
                     showManualEntry = false;
                 }
             }
        }
        else
        {
            ToastService.ShowInfo(Localizer["PleaseLoginTrack"]);
        }
    }

    private async Task EnterSanctuary()
    {
        sanctuary = true;
        await JSRuntime.InvokeVoidAsync("sanctuary.enter");
        if (ambient != "off")
        {
            await JSRuntime.InvokeVoidAsync("sanctuary.start", ambient);
            await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
        }
    }

    private async Task ExitSanctuary()
    {
        sanctuary = false;
        await JSRuntime.InvokeVoidAsync("sanctuary.exit");
        ambient = "off";
    }

    private async Task SetAmbient(string kind)
    {
        ambient = kind;
        await JSRuntime.InvokeVoidAsync("sanctuary.start", kind);
        await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Code == "Space")
        {
            if (TimerService.IsRunning) PauseTimer();
            else await RequestStart();
        }
        else if (e.Code == "Escape" && sanctuary)
        {
            await ExitSanctuary();
        }
    }

    public void Dispose()
    {
        breathCts?.Cancel();
        breathCts?.Dispose();
        TimerService.OnTick -= UpdateUI;
        TimerService.OnTimerCompleted -= HandleTimerCompleted;
        _ = JSRuntime.InvokeVoidAsync("sanctuary.exit");
    }
}
