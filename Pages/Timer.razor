    private void ShowManualEntryModal()
    {
        manualDate = DateTime.Now;
        manualDuration = 30;
        manualTaskSelection = "";
        manualCustomTask = "";
        showManualEntry = true;
    }

    private void CloseManualEntryModal()
    {
        showManualEntry = false;
    }

    private async Task SaveManualEntry()
    {
        if (manualDuration <= 0)
        {
             ToastService.ShowError(Localizer["DurationPositive"]);
             return;
        }

        string taskName = manualTaskSelection == "custom" ? manualCustomTask : manualTaskSelection;
        if (string.IsNullOrWhiteSpace(taskName))
        {
            if (!string.IsNullOrWhiteSpace(manualCustomTask)) taskName = manualCustomTask;
            else taskName = Localizer["ManualSession"];
        }

        var authState = await _authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false)
        {
             var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
             if (!string.IsNullOrEmpty(userId))
             {
                 var result = await GamificationService.RecordFocusSessionAsync(userId, manualDuration, taskName, false, manualDate);
                 
                 if (result.success)
                 {
                     string msg = string.Format(Localizer["ManualEntrySaved"], result.xpAwarded);
                     ToastService.ShowSuccess(msg);
                     showManualEntry = false;
                     await RefreshDailyProgress();
                 }
             }
        }
        else
        {
            var saved = await RecordGuestSession(manualDuration, taskName, false, manualDate);
            if (saved)
            {
                showManualEntry = false;
            }
            else
            {
                ToastService.ShowError(Localizer["DurationPositive"]);
            }
        }
    }

    private async Task EnterSanctuary()
    {
        sanctuary = true;
        await JSRuntime.InvokeVoidAsync("sanctuary.enter");
        if (ambient != "off")
        {
            await JSRuntime.InvokeVoidAsync("sanctuary.start", ambient);
            await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
        }
    }

    private async Task ExitSanctuary()
    {
        sanctuary = false;
        await JSRuntime.InvokeVoidAsync("sanctuary.exit");
        ambient = "off";
    }

    private async Task SetAmbient(string kind)
    {
        ambient = kind;
        await JSRuntime.InvokeVoidAsync("sanctuary.start", kind);
        await JSRuntime.InvokeVoidAsync("sanctuary.setVolume", VolumeGain);
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (showBreath && (e.Key == "s" || e.Key == "S" || e.Code == "Space"))
        {
            await SkipBreath();
            return;
        }
        if (e.Code == "Space")
        {
            if (TimerService.IsRunning) PauseTimer();
            else await RequestStart();
        }
        else if (e.Code == "Escape" && sanctuary)
        {
            await ExitSanctuary();
        }
        else if (!TimerService.IsRunning && !showBreath)
        {
            if (e.Key == "1") await SetMinutesAndStore(15);
            else if (e.Key == "2") await SetMinutesAndStore(25);
            else if (e.Key == "3") await SetMinutesAndStore(50);
        }
    }

    private void ApplyPrefill()
    {
        if (string.Equals(customFocusTask, "custom", StringComparison.OrdinalIgnoreCase))
        {
            customFocusTask = "";
        }

        if (!string.IsNullOrWhiteSpace(TimerService.FocusTask) && TimerService.FocusTask != "custom")
        {
            return;
        }

        if (TimerService.FocusTask == "custom" && !string.IsNullOrWhiteSpace(customFocusTask))
        {
            return;
        }

        var prefill = FocusTaskMatcher.Prefill(todayTasks, todayOneThing);
        if (string.IsNullOrWhiteSpace(prefill.FocusTask)) return;
        TimerService.FocusTask = prefill.FocusTask;
        if (prefill.FocusTask == "custom")
        {
            customFocusTask = prefill.CustomTitle;
        }
    }

    private async Task StartAnother()
    {
        offerBreak = false;
        offerAnother = false;
        pendingTask = null;
        if (TimerService.IsBreakMode)
        {
            TimerService.EndBreak();
        }
        TimerService.SetMode(true);
        await BeginSession();
    }

    private void OfferTaskCompletion()
    {
        pendingTask = FocusTaskMatcher.FindOpen(todayTasks, TimerService.FocusTask, customFocusTask);
    }

    private async Task CompletePendingTask()
    {
        if (pendingTask == null) return;
        var task = pendingTask;
        pendingTask = null;

        if (!string.IsNullOrEmpty(timerUserId))
        {
            var result = await TaskService.ToggleTaskCompletionAsync(task.Id, timerUserId);
            if (result.success && result.xpAwarded > 0)
            {
                ToastService.ShowSuccess(string.Format(Localizer["XPEarnedRemaining"], result.xpAwarded, result.remainingDaily));
            }
            else if (result.success)
            {
                ToastService.ShowSuccess(Localizer["MarkTaskDone"]);
            }
            await LoadTasks();
            return;
        }

        if (await GuestTaskService.ToggleTaskAsync(task.Id))
        {
            ToastService.ShowInfo(Localizer["TaskCompletedGuest"]);
        }
        todayTasks = await GuestTaskService.GetTasksForTodayAsync();
    }

    public void Dispose()
    {
        breathCts?.Cancel();
        breathCts?.Dispose();
        TimerService.OnTick -= UpdateUI;
        TimerService.OnTimerCompleted -= HandleTimerCompleted;
        _ = SetLeaveGuard(false);
        _ = JSRuntime.InvokeVoidAsync("sanctuary.exit");
    }
}
