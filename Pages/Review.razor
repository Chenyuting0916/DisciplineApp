@page "/review"
@inject IGamificationService GamificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> Localizer
@inject NavigationManager NavigationManager
@inject IDataExportService DataExportService
@inject GuestExportService GuestExportService
@inject GuestHabitService GuestHabitService
@inject GuestTaskService GuestTaskService
@inject GuestJournalService GuestJournalService
@inject GuestFocusService GuestFocusService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

<PageTitle>@Localizer["Review"] — Discipline</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="dashboard-container pt-4 pb-5">
            <p class="hero-kicker mb-2">@Localizer["Review"]</p>
            <h1 class="review-hero mb-3">@Localizer["ReviewHeadline"]</h1>
            <p class="text-muted mb-4">@ReviewLetter</p>

            <div class="stat-grid mb-4">
                <div class="stat-card goal">
                    <div class="label">@Localizer["ThisWeek"]</div>
                    <div class="value">@((int)review.FocusMinutes)m</div>
                </div>
                <div class="stat-card">
                    <div class="label">@Localizer["RecentSessions"]</div>
                    <div class="value">@review.SessionCount</div>
                </div>
                <div class="stat-card streak">
                    <div class="label">@Localizer["Streak"]</div>
                    <div class="value">🔥 @review.CurrentStreak</div>
                </div>
                <div class="stat-card coins">
                    <div class="label">@Localizer["Habits"]</div>
                    <div class="value">@review.HabitChecks</div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="mb-3">@Localizer["ReviewDetails"]</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">✅ @string.Format(Localizer["ReviewTasks"], review.TasksCompleted)</li>
                        @if (review.BestDay.HasValue)
                        {
                            <li class="mb-2">📅 @string.Format(Localizer["ReviewBestDay"], review.BestDay.Value.ToString("MM/dd"), (int)review.BestDayMinutes)</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(review.TopFocus))
                        {
                            <li class="mb-2">🎯 @string.Format(Localizer["ReviewTopFocus"], review.TopFocus)</li>
                        }
                        <li>🏅 @string.Format(Localizer["ReviewLevel"], review.Level, review.LongestStreak)</li>
                    </ul>
                </div>
            </div>

            <button class="btn btn-primary" @onclick="GoTimer">@Localizer["StartFocusSession"]</button>
            <button class="btn btn-outline-secondary ms-2" @onclick="ExportData">@Localizer["ExportData"]</button>
            <p class="text-muted small mt-3 mb-0">@Localizer["ExportPrivacyNote"]</p>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="dashboard-container pt-4 pb-5">
            <p class="hero-kicker mb-2">@Localizer["Review"]</p>
            <h1 class="review-hero mb-3">@Localizer["ReviewHeadline"]</h1>
            <p class="text-muted mb-4">@GuestLetter</p>

            <div class="stat-grid mb-4">
                <div class="stat-card goal">
                    <div class="label">@Localizer["ThisWeek"]</div>
                    <div class="value">@((int)guestReview.FocusMinutes)m</div>
                </div>
                <div class="stat-card">
                    <div class="label">@Localizer["RecentSessions"]</div>
                    <div class="value">@guestReview.SessionCount</div>
                </div>
                <div class="stat-card coins">
                    <div class="label">@Localizer["Habits"]</div>
                    <div class="value">@guestReview.HabitChecks</div>
                </div>
                <div class="stat-card streak">
                    <div class="label">@Localizer["Streak"]</div>
                    <div class="value">🔥 @guestReview.CurrentStreak</div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="mb-3">@Localizer["ReviewDetails"]</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">✅ @string.Format(Localizer["ReviewTasks"], guestReview.TasksCompleted)</li>
                        <li class="mb-2">🗣 @string.Format(Localizer["ReviewVowDays"], guestReview.VowDays)</li>
                        @if (guestReview.BestDay.HasValue)
                        {
                            <li class="mb-2">📅 @string.Format(Localizer["ReviewBestDay"], guestReview.BestDay.Value.ToString("MM/dd"), (int)guestReview.BestDayMinutes)</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(guestReview.TopFocus))
                        {
                            <li class="mb-2">🎯 @string.Format(Localizer["ReviewTopFocus"], guestReview.TopFocus)</li>
                        }
                    </ul>
                </div>
            </div>

            <p class="text-muted small mb-4">@Localizer["GuestReviewHint"]</p>
            <button class="btn btn-primary" @onclick="GoTimer">@Localizer["StartFocusSession"]</button>
            <button class="btn btn-outline-secondary ms-2" @onclick="ExportGuest">@Localizer["ExportData"]</button>
            <p class="text-muted small mt-3 mb-0">@Localizer["ExportPrivacyNote"]</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .dashboard-container { max-width: 860px; margin: 0 auto; }
</style>

@code {
    private WeeklyReview review = new();
    private WeeklyReview guestReview = new();
    private bool isGuest;

    private string ReviewLetter =>
        review.FocusMinutes < 1
            ? Localizer["ReviewEmpty"]
            : string.Format(Localizer["ReviewLetter"], (int)review.FocusMinutes, review.SessionCount, review.CurrentStreak);

    private string GuestLetter =>
        guestReview.HabitChecks < 1 && guestReview.TasksCompleted < 1 && guestReview.SessionCount < 1 && guestReview.FocusMinutes < 1 && guestReview.VowDays < 1
            ? Localizer["ReviewGuestEmpty"]
            : string.Format(Localizer["ReviewGuestLetter"], guestReview.HabitChecks, guestReview.TasksCompleted, guestReview.VowDays);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
        isGuest = string.IsNullOrEmpty(userId);
        if (!string.IsNullOrEmpty(userId))
        {
            review = await GamificationService.GetWeeklyReviewAsync(userId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !isGuest) return;
        var habits = await GuestHabitService.GetHabitsAsync();
        var tasks = await GuestTaskService.GetAllAsync();
        var days = await GuestJournalService.GetAllAsync();
        var sessions = await GuestFocusService.GetAllAsync();
        guestReview = GuestJournalLogic.BuildReview(habits, tasks, days, DateTime.UtcNow, sessions);
        StateHasChanged();
    }

    private void GoTimer() => NavigationManager.NavigateTo("/timer");

    private async Task ExportData()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
        if (string.IsNullOrEmpty(userId)) return;

        var json = await DataExportService.ExportJsonAsync(userId);
        await JSRuntime.InvokeVoidAsync("downloadTextFile", InputGuard.ExportFileName(), json, "application/json");
        ToastService.ShowSuccess(Localizer["ExportReady"]);
    }

    private async Task ExportGuest()
    {
        var json = await GuestExportService.ExportJsonAsync();
        await JSRuntime.InvokeVoidAsync("downloadTextFile", InputGuard.ExportFileName(), json, "application/json");
        ToastService.ShowSuccess(Localizer["ExportReady"]);
    }
}
