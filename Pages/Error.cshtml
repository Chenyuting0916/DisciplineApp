@page
@model DisciplineApp.Pages.ErrorModel
@using System.Globalization
@using DisciplineApp.Models

<!DOCTYPE html>
<html lang="@ErrorCopy.HtmlLang(CultureInfo.CurrentUICulture.Name)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@Model.Localizer["ErrorTitle"]</title>
    <link href="~/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="main">
        <div class="content px-4">
            <h1 class="text-danger">@Model.Localizer["ErrorTitle"]</h1>
            <h2 class="h5 text-danger">@Model.Localizer["ErrorBody"]</h2>

            @if (Model.ShowRequestId)
            {
                <p>
                    <strong>@Model.Localizer["RequestId"]:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <p class="mt-3">
                <a href="~/" class="btn btn-outline-primary me-2">@Model.Localizer["GoHome"]</a>
                <a href="~/timer" class="btn btn-primary">@Model.Localizer["StartFocusSession"]</a>
            </p>

            @if (Model.ShowDevelopmentHelp)
            {
                <h3>@Model.Localizer["DevelopmentMode"]</h3>
                <p>@Model.Localizer["DevelopmentModeHint"]</p>
            }
        </div>
    </div>
</body>

</html>
