@page "/"
@using DisciplineApp.Shared
@using DisciplineApp.Services
@using DisciplineApp.Models
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITaskService TaskService
@inject ToastService ToastService
@inject IGamificationService GamificationService
@inject IChallengeService ChallengeService
@inject IHabitService HabitService
@inject IReflectionService ReflectionService
@inject IIntentionService IntentionService
@inject GuestJournalService GuestJournalService
@inject GuestFocusService GuestFocusService
@inject GuestTaskService GuestTaskService
@inject GuestHabitService GuestHabitService
@inject TimerService TimerService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> Localizer

<PageTitle>Discipline — @Localizer["Home"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="dashboard-container pt-3 pb-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <p class="hero-kicker mb-1">@Greeting</p>
                    <h1 class="mb-1">@(currentUser?.DisplayName ?? context.User.Identity?.Name ?? "User")</h1>
                    @if (!string.IsNullOrEmpty(currentUser?.EquippedTitle))
                    {
                        <div class="title-chip mb-1">@Localizer[ShopCatalog.TitleFor(currentUser.EquippedTitle)]</div>
                    }
                    <p class="text-muted mb-0">@Localizer["StayConsistent"]</p>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-outline-primary" @onclick="ShowShareChallengeModal">
                        <i class="bi bi-share"></i> @Localizer["ShareChallenge"]
                    </button>
                    <button class="btn btn-primary" @onclick="GoToTimer">
                        <i class="bi bi-play-fill"></i> @Localizer["StartFocusSession"]
                    </button>
                </div>
            </div>

            <DailyQuote />

            @if (streakStatus == StreakStatus.AtRisk)
            {
                <div class="alert alert-streak d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                    <div>
                        <strong>🔥 @Localizer["StreakAtRisk"]</strong>
                        <div class="small">@string.Format(Localizer["FreezeCost"], 30)</div>
                    </div>
                    <button class="btn btn-warning" @onclick="FreezeStreak">@Localizer["ProtectStreak"]</button>
                </div>
            }

            <div class="stat-grid mb-4">
                <div class="stat-card streak">
                    <div class="label">@Localizer["Streak"]</div>
                    <div class="value">🔥 @(currentUser?.CurrentStreak ?? 0)</div>
                    <div class="small text-muted mt-1">@Localizer["LongestStreak"]: @(currentUser?.LongestStreak ?? 0)</div>
                </div>
                <div class="stat-card goal">
                    <div class="label">@Localizer["DailyGoal"]</div>
                    <div class="value">@((int)todayFocusMinutes)<span class="fs-6 fw-600">/@goalMinutes</span></div>
                    <div class="small text-muted mt-1">
                        @Localizer["TodaysFocus"] ·
                        <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="ShowGoalModal">@Localizer["SetGoal"]</button>
                    </div>
                    <div class="progress mt-2" style="height: 6px; background: var(--bg-tertiary);">
                        <div class="progress-bar" role="progressbar" style="width: @(GoalPercent)%; background: var(--accent-2);"></div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="label">@Localizer["TasksToday"]</div>
                    <div class="value">@completedTaskCount<span class="fs-6">/@totalTaskCount</span></div>
                    <div class="small text-muted mt-1">@Localizer["CompletedOf"]</div>
                </div>
                <div class="stat-card coins">
                    <div class="label">@Localizer["HabitsToday"]</div>
                    <div class="value">@habitCompleted<span class="fs-6">/@habitTotal</span></div>
                    <div class="small text-muted mt-1">💰 @(currentUser?.GoldCoins ?? 0) · ⏱️ @((int)(currentUser?.TotalFocusMinutes ?? 0))m</div>
                </div>
            </div>

            <div class="vow-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">@Localizer["DailyVow"]</h5>
                    @if (todayIntention != null)
                    {
                        <span class="badge bg-success">@Localizer["VowSet"]</span>
                    }
                </div>
                <p class="text-muted small mb-3">@Localizer["DailyVowHint"]</p>
                <div class="mb-2">
                    <input class="form-control mb-2" maxlength="140" @bind="vowText" placeholder="@Localizer["VowPlaceholder"]" />
                    <input class="form-control" maxlength="80" @bind="oneThing" placeholder="@Localizer["OneThingPlaceholder"]" />
                </div>
                <button class="btn btn-primary mt-2" @onclick="SaveVow">@Localizer["CommitVow"]</button>
                @if (!string.IsNullOrWhiteSpace(todayIntention?.OneThing))
                {
                        <button class="btn btn-outline-primary mt-2 ms-2" @onclick="GoStartThisThing">@Localizer["StartThisThing"]</button>
                }
            </div>

            <IfThenPanel IsGuest="false" UserId="@currentUser?.Id" />

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">@Localizer["DailyCheckIn"]</h5>
                        @if (todayReflection != null)
                        {
                            <span class="badge bg-success">@Localizer["SavedReflection"]</span>
                        }
                    </div>
                    <p class="text-muted small mb-3">@Localizer["HowAreYouFeeling"]</p>
                    <div class="mood-picker mb-3">
                        @foreach (var mood in moods)
                        {
                            <button class="mood-btn @(selectedMood == mood.Value ? "active" : "")" @onclick="() => selectedMood = mood.Value" title="@mood.Label">@mood.Emoji</button>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <input class="form-control" maxlength="280" @bind="reflectionNote" placeholder="@Localizer["ReflectionPlaceholder"]" />
                        <button class="btn btn-primary" @onclick="SaveReflection">@Localizer["Save"]</button>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <Heatmap />
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-4 mb-md-0">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@Localizer["TasksToday"]</h5>
                            <a href="tasks" class="btn btn-sm btn-outline-primary">@Localizer["ViewAll"]</a>
                        </div>
                        <div class="card-body">
                            @if (todayTasks == null)
                            {
                                <p class="text-muted">@Localizer["LoadingTasks"]</p>
                            }
                            else if (!todayTasks.Any())
                            {
                                <p class="text-muted">@Localizer["NoTasks"] <a href="tasks">@Localizer["AddOne"]</a>!</p>
                            }
                            else
                            {
                                var sortedTasks = todayTasks.OrderBy(t => !t.IsRoutine).ThenBy(t => t.Title).ToList();
                                <ul class="list-group list-group-flush">
                                    @foreach (var task in sortedTasks.Take(5))
                                    {
                                        <li class="list-group-item d-flex align-items-center @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")" style="cursor: pointer;">
                                            <input type="checkbox" class="form-check-input me-2" checked="@task.IsCompleted" @onchange="() => ToggleTask(task)">
                                            @task.Title
                                            @if (task.IsRoutine)
                                            {
                                                <span class="badge bg-info text-dark ms-2">@Localizer["RoutineBadge"]</span>
                                            }
                                            @if (task.XpAwarded)
                                            {
                                                <span class="ms-auto badge bg-success">@Localizer["XPEarned"]</span>
                                            }
                                            else
                                            {
                                                <span class="ms-auto badge bg-secondary">+50 XP</span>
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (todayTasks.Count > 5)
                                {
                                    <p class="text-muted mt-2 mb-0">+@(todayTasks.Count - 5) @Localizer["MoreTasks"]</p>
                                }
                            }
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                     <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">@Localizer["WeeklyFocus"]</h5>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousWeek">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span class="small text-muted">@weekRangeDisplay</span>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="NextWeek" disabled="@isCurrentWeek">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            @if (weeklyFocusBreakdown.Any())
                            {
                                <ul class="list-group list-group-flush mb-3 flex-grow-1">
                                    @foreach (var item in weeklyFocusBreakdown.OrderByDescending(x => x.Value))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                            <span>@item.Key</span>
                                            <span class="badge bg-secondary rounded-pill">@((int)item.Value)m</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted text-center flex-grow-1 d-flex align-items-center justify-content-center">
                                    @Localizer["NoFocusSessions"]
                                </p>
                            }
                            
                            <div class="text-center mt-auto">
                                <a href="timer" class="btn btn-primary w-100">
                                    <i class="bi bi-play-circle-fill me-2"></i> @Localizer["StartFocusSession"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <DisciplineApp.Shared.CoinReward IsVisible="@showCoinReward" Coins="@coinsEarned" Xp="@xpEarned" />
        </div>
    </Authorized>
    <NotAuthorized>
        <section class="hero-landing">
            <p class="hero-kicker">Discipline</p>
            <h1>@Localizer["LandingTitle"]</h1>
            <p class="lead">@Localizer["LandingSubtitle"]</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <button class="btn btn-lg btn-primary px-4" @onclick="ShowLoginModal">@Localizer["LandingCta"]</button>
                <a class="btn btn-lg btn-outline-primary px-4" href="timer">@Localizer["TryTimer"]</a>
            </div>
        </section>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="icon">🍅</div>
                <h5>@Localizer["FeatureTimer"]</h5>
                <p class="text-muted mb-0">@Localizer["FeatureTimerDesc"]</p>
            </div>
            <div class="feature-card">
                <div class="icon">🔥</div>
                <h5>@Localizer["FeatureStreaks"]</h5>
                <p class="text-muted mb-0">@Localizer["FeatureStreaksDesc"]</p>
            </div>
            <div class="feature-card">
                <div class="icon">✅</div>
                <h5>@Localizer["FeatureHabits"]</h5>
                <p class="text-muted mb-0">@Localizer["FeatureHabitsDesc"]</p>
            </div>
            <div class="feature-card">
                <div class="icon">🎮</div>
                <h5>@Localizer["FeatureXp"]</h5>
                <p class="text-muted mb-0">@Localizer["FeatureXpDesc"]</p>
            </div>
        </div>

        <div class="card mx-auto mb-5" style="max-width: 880px;">
            <div class="card-body p-4">
                <h4 class="mb-4">@Localizer["HowItWorks"]</h4>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="hero-kicker mb-2">01</div>
                        <h5>@Localizer["Step1Title"]</h5>
                        <p class="text-muted mb-0">@Localizer["Step1Desc"]</p>
                    </div>
                    <div class="col-md-4">
                        <div class="hero-kicker mb-2">02</div>
                        <h5>@Localizer["Step2Title"]</h5>
                        <p class="text-muted mb-0">@Localizer["Step2Desc"]</p>
                    </div>
                    <div class="col-md-4">
                        <div class="hero-kicker mb-2">03</div>
                        <h5>@Localizer["Step3Title"]</h5>
                        <p class="text-muted mb-0">@Localizer["Step3Desc"]</p>
                    </div>
                </div>
            </div>
        </div>

        @if (guestReady)
        {
            <div class="dashboard-container pt-2 pb-5">
                <p class="text-muted small mb-3">@Localizer["GuestHomeHint"]</p>
                <div class="stat-grid mb-4">
                    <div class="stat-card goal">
                        <div class="label">@Localizer["DailyGoal"]</div>
                        <div class="value">@((int)todayFocusMinutes)<span class="fs-6 fw-600">/@goalMinutes</span></div>
                        <div class="small text-muted mt-1">
                            @Localizer["TodaysFocus"] ·
                            <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="ShowGoalModal">@Localizer["SetGoal"]</button>
                        </div>
                        <div class="progress mt-2" style="height: 6px; background: var(--bg-tertiary);">
                            <div class="progress-bar" role="progressbar" style="width: @(GoalPercent)%; background: var(--accent-2);"></div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="label">@Localizer["TasksToday"]</div>
                        <div class="value">@completedTaskCount<span class="fs-6">/@totalTaskCount</span></div>
                        <div class="small text-muted mt-1">@Localizer["CompletedOf"]</div>
                    </div>
                    <div class="stat-card coins">
                        <div class="label">@Localizer["HabitsToday"]</div>
                        <div class="value">@habitCompleted<span class="fs-6">/@habitTotal</span></div>
                    </div>
                    <div class="stat-card streak">
                        <div class="label">@Localizer["Streak"]</div>
                        <div class="value">🔥 @guestStreak</div>
                        <div class="small text-muted mt-1">@Localizer["GuestStreakHint"]</div>
                    </div>
                </div>
                <button class="btn btn-primary mb-4" @onclick="GoToTimer">
                    <i class="bi bi-play-fill"></i> @Localizer["StartFocusSession"]
                </button>
                <div class="row mb-4">
                    <div class="col-md-6 mb-4 mb-md-0">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@Localizer["TasksToday"]</h5>
                                <a href="tasks" class="btn btn-sm btn-outline-primary">@Localizer["ViewAll"]</a>
                            </div>
                            <div class="card-body">
                                @if (todayTasks == null || !todayTasks.Any())
                                {
                                    <p class="text-muted mb-0">@Localizer["NoTasks"] <a href="tasks">@Localizer["AddOne"]</a></p>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var task in todayTasks.OrderBy(t => t.IsCompleted).ThenBy(t => t.Title).Take(5))
                                        {
                                            <li class="list-group-item d-flex align-items-center @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                                <input type="checkbox" class="form-check-input me-2" checked="@task.IsCompleted" @onchange="() => ToggleTask(task)">
                                                @task.Title
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@Localizer["HabitsToday"]</h5>
                                <a href="habits" class="btn btn-sm btn-outline-primary">@Localizer["ViewAll"]</a>
                            </div>
                            <div class="card-body">
                                @if (!guestHabits.Any())
                                {
                                    <p class="text-muted mb-3">@Localizer["NoHabits"]</p>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="preset-chip" @onclick="@(() => QuickAddGuestHabit("HabitWater", "💧", "#38bdf8"))">💧 @Localizer["HabitWater"]</button>
                                        <button class="preset-chip" @onclick="@(() => QuickAddGuestHabit("HabitRead", "📚", "#a78bfa"))">📚 @Localizer["HabitRead"]</button>
                                        <button class="preset-chip" @onclick="@(() => QuickAddGuestHabit("HabitExercise", "🏃", "#f97316"))">🏃 @Localizer["HabitExercise"]</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var habit in guestHabits.Take(5))
                                        {
                                            var doneToday = GuestHabitDoneToday(habit);
                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="habit-check @(doneToday ? "done" : "")" style="--habit-color: @habit.Color" @onclick="() => ToggleGuestHabit(habit)">
                                                    @(doneToday ? "✓" : habit.Icon)
                                                </button>
                                                <span>@habit.Title</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="vow-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">@Localizer["DailyVow"]</h5>
                        @if (todayIntention != null)
                        {
                            <span class="badge bg-success">@Localizer["VowSet"]</span>
                        }
                    </div>
                    <p class="text-muted small mb-3">@Localizer["DailyVowHint"]</p>
                    <div class="mb-2">
                        <input class="form-control mb-2" maxlength="140" @bind="vowText" placeholder="@Localizer["VowPlaceholder"]" />
                        <input class="form-control" maxlength="80" @bind="oneThing" placeholder="@Localizer["OneThingPlaceholder"]" />
                    </div>
                    <button class="btn btn-primary mt-2" @onclick="SaveVow">@Localizer["CommitVow"]</button>
                    @if (!string.IsNullOrWhiteSpace(todayIntention?.OneThing))
                    {
                        <button class="btn btn-outline-primary mt-2 ms-2" @onclick="GoStartThisThing">@Localizer["StartThisThing"]</button>
                    }
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">@Localizer["DailyCheckIn"]</h5>
                            @if (todayReflection != null)
                            {
                                <span class="badge bg-success">@Localizer["SavedReflection"]</span>
                            }
                        </div>
                        <p class="text-muted small mb-3">@Localizer["HowAreYouFeeling"]</p>
                        <div class="mood-picker mb-3">
                            @foreach (var mood in moods)
                            {
                                <button class="mood-btn @(selectedMood == mood.Value ? "active" : "")" @onclick="() => selectedMood = mood.Value" title="@mood.Label">@mood.Emoji</button>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <input class="form-control" maxlength="280" @bind="reflectionNote" placeholder="@Localizer["ReflectionPlaceholder"]" />
                            <button class="btn btn-primary" @onclick="SaveReflection">@Localizer["Save"]</button>
                        </div>
                    </div>
                </div>

                <IfThenPanel IsGuest="true" />
                <div class="mt-4">
                    <Heatmap GuestActivity="@guestActivity" Hint="@Localizer["GuestHeatmapHint"]" />
                </div>
            </div>
        }
    </NotAuthorized>
</AuthorizeView>

@if (showLoginModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@Localizer["Login"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideLoginModal"></button>
                </div>
                <div class="modal-body text-center p-5">
                    <h4 class="mb-4">@Localizer["Welcome"]</h4>
                    <a href="Account/LoginWithGoogle" class="btn btn-lg btn-light w-100 d-flex align-items-center justify-content-center gap-2">
                        <img src="https://www.google.com/favicon.ico" alt="Google" width="20" height="20">
                        @Localizer["ContinueWithGoogle"]
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@if (showShareChallengeModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">
                        <i class="bi bi-share"></i> @Localizer["ShareChallenge"]
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideShareChallengeModal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-3">@Localizer["ShareChallengeDesc"]</p>
                    
                    @if (shareLink == null)
                    {
                        <button class="btn btn-primary w-100" @onclick="GenerateShareLink" disabled="@isGeneratingLink">
                            @if (isGeneratingLink)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @Localizer["GenerateLink"]
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-success mb-3">
                            <strong>@Localizer["LinkReady"]</strong>
                        </div>
                        
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" value="@shareLink" readonly>
                            <button class="btn btn-outline-light" @onclick="CopyToClipboard">
                                <i class="bi bi-clipboard"></i> @Localizer["Copy"]
                            </button>
                        </div>
                        
                        <div class="text-muted small">
                            <p class="mb-1">@Localizer["ShareInstructions"]</p>
                            <ul class="mb-0">
                                <li>@Localizer["ShareVia1"]</li>
                                <li>@Localizer["ShareVia2"]</li>
                                <li>@Localizer["ShareVia3"]</li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showGoalModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@Localizer["SetGoal"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showGoalModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">@Localizer["DailyGoalHint"]</label>
                    <input type="number" class="form-control" min="10" max="720" @bind="goalDraft" />
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary" @onclick="() => showGoalModal = false">@Localizer["Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveGoal">@Localizer["Save"]</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .dashboard-container {
        max-width: 980px;
        margin: 0 auto;
    }
</style>

@code {
    private List<UserTask>? todayTasks;
    private ApplicationUser? currentUser;
    private bool showLoginModal = false;
    private double weeklyFocusMinutes = 0;
    private Dictionary<string, double> weeklyFocusBreakdown = new();
    private DateTime currentWeekStart = DateTime.UtcNow.Date;
    private double todayFocusMinutes;
    private StreakStatus streakStatus = StreakStatus.None;
    private int habitCompleted;
    private int habitTotal;
    private DailyReflection? todayReflection;
    private DailyIntention? todayIntention;
    private string vowText = "";
    private string oneThing = "";
    private int selectedMood = 3;
    private string reflectionNote = "";
    private bool showGoalModal;
    private int goalDraft = 60;
    
    private bool isCurrentWeek => currentWeekStart >= GetStartOfWeek(DateTime.UtcNow.Date);
    private string weekRangeDisplay => $"{currentWeekStart:MM/dd} - {currentWeekStart.AddDays(6):MM/dd}";
    private int guestGoalMinutes = 60;
    private int goalMinutes => isGuest
        ? (guestGoalMinutes > 0 ? guestGoalMinutes : 60)
        : (currentUser?.DailyFocusGoalMinutes > 0 ? currentUser.DailyFocusGoalMinutes : 60);
    private int GoalPercent => goalMinutes <= 0 ? 0 : (int)Math.Clamp(todayFocusMinutes / goalMinutes * 100, 0, 100);
    private int completedTaskCount => todayTasks?.Count(t => t.IsCompleted) ?? 0;
    private int totalTaskCount => todayTasks?.Count ?? 0;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour < 12) return Localizer["GreetingMorning"];
            if (hour < 18) return Localizer["GreetingAfternoon"];
            return Localizer["GreetingEvening"];
        }
    }

    private record MoodOption(int Value, string Emoji, string Label);
    private List<MoodOption> moods = new();

    private bool guestReady;
    private bool isGuest = true;
    private bool showCoinReward = false;
    private int coinsEarned = 0;
    private int xpEarned = 0;
    private List<Habit> guestHabits = new();
    private Dictionary<DateTime, int> guestActivity = new();
    private int guestStreak;

    protected override async Task OnInitializedAsync()
    {
        moods = new List<MoodOption>
        {
            new(1, "😞", Localizer["MoodTerrible"]),
            new(2, "😕", Localizer["MoodBad"]),
            new(3, "😐", Localizer["MoodOk"]),
            new(4, "🙂", Localizer["MoodGood"]),
            new(5, "😄", Localizer["MoodGreat"]),
        };

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentWeekStart = GetStartOfWeek(DateTime.UtcNow.Date);

        if (user.Identity?.IsAuthenticated ?? false)
        {
            isGuest = false;
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                await ReloadDashboard(userId);
            }
        }
        else
        {
            isGuest = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !isGuest) return;
        var today = await GuestJournalService.GetTodayAsync();
        if (today != null)
        {
            vowText = today.Vow;
            oneThing = today.OneThing;
            selectedMood = today.Mood;
            reflectionNote = today.Note ?? "";
            if (!string.IsNullOrWhiteSpace(today.Vow) || !string.IsNullOrWhiteSpace(today.OneThing))
            {
                todayIntention = new DailyIntention { Vow = today.Vow, OneThing = today.OneThing, Date = today.Date };
            }
            if (today.Mood != 0 || !string.IsNullOrWhiteSpace(today.Note))
            {
                todayReflection = new DailyReflection { Mood = today.Mood, Note = today.Note, Date = today.Date };
            }
        }
        guestGoalMinutes = await GuestFocusService.GetGoalAsync();
        todayFocusMinutes = await GuestFocusService.GetTodayMinutesAsync();
        await ReloadGuestLoop();
        guestReady = true;
        StateHasChanged();
    }

    private async Task ReloadDashboard(string userId)
    {
        todayTasks = await TaskService.GetTasksForDateAsync(userId, DateTime.Today);
        currentUser = await GamificationService.GetUserStatsAsync(userId);
        streakStatus = await GamificationService.GetStreakStatusAsync(userId);
        todayFocusMinutes = await GamificationService.GetTodayFocusMinutesAsync(userId);
        (habitCompleted, habitTotal) = await HabitService.GetTodayProgressAsync(userId);
        todayReflection = await ReflectionService.GetTodayAsync(userId);
        todayIntention = await IntentionService.GetTodayAsync(userId);
        if (todayReflection != null)
        {
            selectedMood = todayReflection.Mood;
            reflectionNote = todayReflection.Note ?? "";
        }
        if (todayIntention != null)
        {
            vowText = todayIntention.Vow;
            oneThing = todayIntention.OneThing;
        }
        await LoadWeeklyStats(userId);
    }
    
    private DateTime GetStartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Sunday)) % 7;
        return date.AddDays(-1 * diff).Date;
    }
    
    private async Task PreviousWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(-7);
        await ReloadWeeklyStats();
    }
    
    private async Task NextWeek()
    {
        if (isCurrentWeek) return;
        currentWeekStart = currentWeekStart.AddDays(7);
        await ReloadWeeklyStats();
    }
    
    private async Task ReloadWeeklyStats()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            await LoadWeeklyStats(userId);
        }
    }
    
    private async Task LoadWeeklyStats(string userId)
    {
        weeklyFocusMinutes = await GamificationService.GetWeeklyFocusTimeAsync(userId, currentWeekStart);
        weeklyFocusBreakdown = await GamificationService.GetWeeklyFocusBreakdownAsync(userId, currentWeekStart);
    }

    private async Task ToggleTask(UserTask task)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                var result = await TaskService.ToggleTaskCompletionAsync(task.Id, userId);
                
                if (result.success && result.xpAwarded > 0)
                {
                    xpEarned = result.xpAwarded;
                    
                    var coinResult = new Random().Next(0, 4);
                    if (coinResult > 0)
                    {
                        await GamificationService.AwardCoinsAsync(userId, coinResult, coinResult);
                        coinsEarned = coinResult;
                    }
                    else
                    {
                        coinsEarned = 0;
                    }

                    showCoinReward = true;
                    StateHasChanged();
                    
                    var _ = Task.Delay(3000).ContinueWith(_ => 
                    {
                        showCoinReward = false;
                        InvokeAsync(StateHasChanged);
                    });
                }
                else if (result.capReached)
                {
                    ToastService.ShowWarning(Localizer["DailyCapReached"]);
                }
                
                await ReloadDashboard(userId);
                StateHasChanged();
            }
        }
        else
        {
            var completed = await GuestTaskService.ToggleTaskAsync(task.Id);
            todayTasks = await GuestTaskService.GetTasksForTodayAsync();
            if (completed)
            {
                ToastService.ShowInfo(Localizer["TaskCompletedGuest"]);
            }
        }
    }

    private bool GuestHabitDoneToday(Habit habit)
        => habit.Logs.Any(l => l.Date.Date == DateTime.UtcNow.Date);

    private async Task ReloadGuestLoop()
    {
        todayTasks = await GuestTaskService.GetTasksForTodayAsync();
        guestHabits = await GuestHabitService.GetHabitsAsync();
        habitCompleted = guestHabits.Count(GuestHabitDoneToday);
        habitTotal = guestHabits.Count;
        var sessions = await GuestFocusService.GetAllAsync();
        var weekSunday = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
        guestActivity = GuestFocusLogic.BuildHeatmap(sessions, todayTasks, guestHabits, weekSunday.AddDays(-52 * 7));
        guestStreak = GuestFocusLogic.ActivityStreak(guestActivity.Keys, DateTime.UtcNow);
    }

    private async Task ToggleGuestHabit(Habit habit)
    {
        await GuestHabitService.ToggleTodayAsync(habit.Id);
        await ReloadGuestLoop();
    }

    private async Task QuickAddGuestHabit(string titleKey, string icon, string color)
    {
        var added = await GuestHabitService.AddHabitAsync(Localizer[titleKey], icon, color);
        if (added == null)
        {
            ToastService.ShowError(Localizer["HabitLimit"]);
            return;
        }
        await ReloadGuestLoop();
        ToastService.ShowSuccess(Localizer["HabitCreated"]);
    }

    private async Task SaveReflection()
    {
        var userId = await GetUserId();
        if (userId == null)
        {
            var saved = await GuestJournalService.SaveMoodAsync(selectedMood, reflectionNote);
            todayReflection = new DailyReflection { Mood = saved.Mood, Note = saved.Note, Date = saved.Date };
            ToastService.ShowSuccess(Localizer["SavedReflection"]);
            return;
        }
        todayReflection = await ReflectionService.SaveTodayAsync(userId, selectedMood, reflectionNote);
        currentUser = await GamificationService.GetUserStatsAsync(userId);
        streakStatus = await GamificationService.GetStreakStatusAsync(userId);
        ToastService.ShowSuccess(Localizer["SavedReflection"]);
    }

    private async Task SaveVow()
    {
        var userId = await GetUserId();
        if (userId == null)
        {
            var saved = await GuestJournalService.SaveVowAsync(vowText, oneThing);
            todayIntention = new DailyIntention { Vow = saved.Vow, OneThing = saved.OneThing, Date = saved.Date };
            ToastService.ShowSuccess(Localizer["VowSet"]);
            return;
        }
        todayIntention = await IntentionService.SaveTodayAsync(userId, vowText, oneThing);
        streakStatus = await GamificationService.GetStreakStatusAsync(userId);
        currentUser = await GamificationService.GetUserStatsAsync(userId);
        ToastService.ShowSuccess(Localizer["VowSet"]);
    }

    private async Task FreezeStreak()
    {
        var userId = await GetUserId();
        if (userId == null) return;
        var result = await GamificationService.FreezeStreakAsync(userId);
        if (result.success)
        {
            ToastService.ShowSuccess(Localizer["StreakSaved"]);
            await ReloadDashboard(userId);
        }
        else
        {
            ToastService.ShowWarning(Localizer["NotEnoughCoins"]);
        }
    }

    private void ShowGoalModal()
    {
        goalDraft = goalMinutes;
        showGoalModal = true;
    }

    private async Task SaveGoal()
    {
        var userId = await GetUserId();
        if (userId == null)
        {
            guestGoalMinutes = await GuestFocusService.SetGoalAsync(goalDraft);
            showGoalModal = false;
            ToastService.ShowSuccess(Localizer["GoalUpdated"]);
            return;
        }
        await GamificationService.UpdateDailyFocusGoalAsync(userId, goalDraft);
        currentUser = await GamificationService.GetUserStatsAsync(userId);
        showGoalModal = false;
        ToastService.ShowSuccess(Localizer["GoalUpdated"]);
    }

    private async Task<string?> GetUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
    }

    private void ShowLoginModal() => showLoginModal = true;
    private void HideLoginModal() => showLoginModal = false;
    private void GoToTimer() => NavigationManager.NavigateTo("/timer");

    private void GoStartThisThing()
    {
        TimerService.FocusTask = "";
        NavigationManager.NavigateTo("/timer");
    }

    private bool showShareChallengeModal = false;
    private string? shareLink;
    private bool isGeneratingLink = false;

    private void ShowShareChallengeModal() => showShareChallengeModal = true;
    private void HideShareChallengeModal()
    {
        showShareChallengeModal = false;
        shareLink = null;
    }

    private async Task GenerateShareLink()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        if (user.Identity?.IsAuthenticated ?? false)
        {
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            var userName = currentUser?.DisplayName ?? user.Identity?.Name ?? "User";
            
            if (!string.IsNullOrEmpty(userId))
            {
                isGeneratingLink = true;
                var token = await ChallengeService.CreateChallengeAsync(userId, userName);
                shareLink = $"{NavigationManager.BaseUri}challenge/{token}";
                isGeneratingLink = false;
                StateHasChanged();
            }
        }
    }

    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrEmpty(shareLink))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", shareLink);
            ToastService.ShowSuccess(Localizer["LinkCopied"]);
        }
    }
}
