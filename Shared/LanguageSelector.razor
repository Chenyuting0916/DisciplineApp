@using System.Globalization
@inject NavigationManager NavigationManager

<div class="dropdown">
    <button class="btn btn-link text-light text-decoration-none dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="oi oi-globe me-1"></span> @CurrentCultureName
    </button>
    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="languageDropdown">
        <li>
            <form method="post" action="Culture/Set" class="m-0">
                <input type="hidden" name="__RequestVerificationToken" value="@CsrfToken" />
                <input type="hidden" name="culture" value="zh-TW" />
                <input type="hidden" name="redirectUri" value="@CurrentPath" />
                <button type="submit" class="dropdown-item @(CurrentCulture == "zh-TW" ? "active" : "")">繁體中文</button>
            </form>
        </li>
        <li>
            <form method="post" action="Culture/Set" class="m-0">
                <input type="hidden" name="__RequestVerificationToken" value="@CsrfToken" />
                <input type="hidden" name="culture" value="en" />
                <input type="hidden" name="redirectUri" value="@CurrentPath" />
                <button type="submit" class="dropdown-item @(CurrentCulture == "en" ? "active" : "")">English</button>
            </form>
        </li>
        <li>
            <form method="post" action="Culture/Set" class="m-0">
                <input type="hidden" name="__RequestVerificationToken" value="@CsrfToken" />
                <input type="hidden" name="culture" value="ja" />
                <input type="hidden" name="redirectUri" value="@CurrentPath" />
                <button type="submit" class="dropdown-item @(CurrentCulture == "ja" ? "active" : "")">日本語</button>
            </form>
        </li>
    </ul>
</div>

@code {
    [CascadingParameter(Name = "CsrfToken")]
    public string? CsrfToken { get; set; }

    private string CurrentCulture => CultureInfo.CurrentCulture.Name;

    private string CurrentCultureName => CurrentCulture switch
    {
        "zh-TW" => "繁體中文",
        "en" => "English",
        "ja" => "日本語",
        _ => "Language"
    };

    private string CurrentPath
    {
        get
        {
            var path = new Uri(NavigationManager.Uri)
                .GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
            return path.StartsWith('/') && !path.StartsWith("//", StringComparison.Ordinal) ? path : "/";
        }
    }
}
